# pnpm 11 only reads auth/registry settings from this file. pnpm's own settings
# (minimumReleaseAge, ignoreScripts, overrides) live in pnpm-workspace.yaml.
#
# This line is NOT what blocks scripts under pnpm — it is a backstop for an
# accidental `npm`/`npx` invocation in this directory. pnpm's equivalent is
# `ignoreScripts: true` in pnpm-workspace.yaml.
ignore-scripts=true
