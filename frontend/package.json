{
  "name": "filebrowser-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run typecheck && vite build",
    "clean": "find ./dist -maxdepth 1 -mindepth 1 ! -name '.gitkeep' -exec rm -r {} +",
    "typecheck": "vue-tsc -p ./tsconfig.app.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chenfengyuan/vue-number-input": "^2.0.1",
    "ace-builds": "^1.44.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "filesize": "^11.0.22",
    "marked": "^18.0.9",
    "material-icons": "^1.13.14",
    "normalize.css": "^8.0.1",
    "pinia": "^4.0.2",
    "qrcode.vue": "^3.10.0",
    "three": "0.185.1",
    "tus-js-client": "^4.3.1",
    "video.js": "^8.24.0",
    "videojs-hotkeys": "^0.2.30",
    "videojs-mobile-ui": "^1.2.7",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^5.2.0",
    "vue-toastification": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
